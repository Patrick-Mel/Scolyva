# ==============================================================================
# SCOLYVA BACKEND ENVIRONMENT VARIABLES CONFIGURATION EXAMPLE
# ==============================================================================

SECRET_KEY=your-super-secret-django-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.scolyva.com

# PostgreSQL Database Configuration
DATABASE_URL=postgres://scolyva_user:scolyva_password@localhost:5432/scolyva_db

# Cloudflare R2 Object Storage Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=scolyva-storage
R2_CUSTOM_DOMAIN=https://files.scolyva.com

# CinetPay Gateway Credentials (Mobile Money Orange / MTN)
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
CINETPAY_SECRET_KEY=your_cinetpay_secret_key
CINETPAY_NOTIFY_URL=https://api.scolyva.com/api/v1/finances/payments/webhook/
